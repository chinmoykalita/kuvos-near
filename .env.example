# kuvos-near local configuration. Copy to .env and fill the NEAR values.
# Synthetic data only: never upload real patient documents to this demo.

# --- Database (local Postgres; see README) ---
DATABASE_URL=postgresql://kuvos@localhost:5433/kuvos_near

# --- API ---
PORT=3001
NODE_ENV=development
BETTER_AUTH_SECRET=            # 32+ random characters: openssl rand -hex 32
# Local defaults. In production the web app is https://app.kuvosai.com: set WEB_ORIGIN to it and
# BETTER_AUTH_URL to the public API origin (the API must share the site with the web app for cookies).
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:8090
DEFAULT_TIMEZONE=Asia/Kolkata
# Console OTP is for synthetic team/judge testing only. Demo phone +919000000001, code 900001.
AUTH_SMS_MODE=console
AUTH_ALLOW_CONSOLE_OTP=true
# Where account-deletion requests are emailed (Resend). Optional for local demos.
ACCOUNT_DELETION_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=             # e.g. Kuvos <no-reply@kuvosai.com>
# Optional social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# --- Private document storage (local MinIO, S3-compatible) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=kuvoslocal
AWS_SECRET_ACCESS_KEY=kuvoslocalsecret
AWS_ENDPOINT_URL_S3=http://localhost:9000
S3_FORCE_PATH_STYLE=true
DOCUMENTS_BUCKET=kuvos-near-documents

# --- NEAR AI Cloud private inference (TEE) ---
# Key from https://cloud.near.ai (or $10 credits via nearbuilders.org).
NEARAI_API_KEY=
NEARAI_E2EE=true
# Qwen reasoning traces make each extraction call minutes slower; off by default.
NEARAI_THINKING=false
# Worker: Confidential TEE models only (owned_by "nearai" in /v1/models)
NEARAI_EXTRACTOR_MODELS=Qwen/Qwen3.6-35B-A3B-FP8
# Empty = no evaluator: the single extractor's items go straight to human review.
NEARAI_EVALUATOR_MODEL=
NEARAI_VISION_OCR_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Tomo chat
CHAT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
CHAT_TRANSCRIPTION_MODEL=openai/whisper-large-v3
CHAT_PROCESSING_APPROVED=true

# --- NEAR Protocol anchoring (testnet) ---
NEAR_ENABLED=true
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Account that holds the kuvos-anchor contract
NEAR_CONTRACT_ID=
# Function-call access key on NEAR_CONTRACT_ID limited to anchor/publish_policy (ed25519:...).
# Create it with: pnpm --filter @kuvos-near/api near:keys
NEAR_PUBLISHER_KEY=
NEAR_ANCHOR_INTERVAL_MS=30000

# --- Worker ---
WORKER_POLL_SECONDS=2
KUVOS_DATA_DIR=./data
