# kuvos-near API (local default). In production (web app on https://app.kuvosai.com) use the public API origin + /api
EXPO_PUBLIC_API_URL=http://localhost:3001/api
# One-tap synthetic demo account (+919000000001 / 900001). Set to false to hide.
EXPO_PUBLIC_DEMO_SIGN_IN=true
# Show Apple/Google buttons only when the API has those providers configured.
EXPO_PUBLIC_SOCIAL_SIGN_IN=false
