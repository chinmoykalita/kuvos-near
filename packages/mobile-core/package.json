  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:notifications": "node --no-warnings --experimental-strip-types src/notification-schedule.check.ts",
    "check:review": "node --no-warnings --experimental-strip-types src/review.check.ts",
    "check:scans": "node --no-warnings --experimental-strip-types src/scan-pages.check.ts",
    "check:boundary": "node check-boundary.mjs",
    "check:activity": "node --no-warnings --experimental-strip-types src/activity-log.check.ts",
    "check:loading": "node tools/check-loading.cjs",
    "import:physio": "node tools/import-physio.mjs",
    "check:physio": "node tools/check-physio.mjs",
    "check:chat": "node --no-warnings --experimental-strip-types src/chat.check.ts",
    "check:wearables": "node --no-warnings --experimental-strip-types src/wearables/metrics.check.ts"
